{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "EnterWorktree",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/worktree-enter.mjs"],
            "timeout": 10,
            "statusMessage": "Steering worktree entry..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/worktree-guard.mjs"],
            "timeout": 10,
            "statusMessage": "Checking for manual worktree creation..."
          }
        ]
      }
    ]
  }
}
